{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#format": {},
    "//#lint": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:bun": {
      "dependsOn": ["^build"]
    },
    "test:cf": {
      "dependsOn": ["^build"]
    },
    "test:deno": {
      "dependsOn": ["^build"]
    },
    "check:readme": {
      "inputs": ["package.json", "README.md"],
      "outputs": []
    },
    "publint": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
