{
  "name": "@glion/check-repo-config",
  "version": "0.0.0",
  "private": true,
  "description": "Internal tool: diff the live GitHub repository configuration against the baseline committed under .github/repo-baseline.",
  "bin": {
    "glion-check-repo-config": "./src/cli.mjs"
  },
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
