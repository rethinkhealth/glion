    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@glion/check-readme": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.0.18",
    "publint": "0.3.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
