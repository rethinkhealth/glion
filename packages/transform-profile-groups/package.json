{
  "name": "@glion/transform-profile-groups",
  "version": "0.23.0",
  "description": "Unified plugin to group HL7v2 segments into the segment groups their event schema defines",
  "keywords": [
    "group",
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "nodejs",
    "plugin",
    "profile",
    "transform",
    "typescript",
    "unified"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/transform-profile-groups"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:readme": "glion-check-readme",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@glion/ast": "workspace:*",
    "@glion/profiles": "workspace:*",
    "@glion/util-query": "workspace:*",
    "@glion/util-visit": "workspace:*",
    "unified": "11.0.5",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@glion/annotate-profile-context": "workspace:*",
    "@glion/annotate-profile-fields": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/to-hl7v2": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.11",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
