{
  "name": "@glion/transform-trim-trailing-fields",
  "version": "0.30.0",
  "description": "Unified plugin to remove the empty fields at the end of each HL7v2 segment",
  "keywords": [
    "field",
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "nodejs",
    "plugin",
    "trailing",
    "transform",
    "typescript",
    "unified"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/transform-trim-trailing-fields"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:readme": "glion-check-readme",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publint": "publint --strict",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@glion/ast": "workspace:*",
    "@glion/util-visit": "workspace:*",
    "@glion/utils": "workspace:*",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@glion/builder": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/to-hl7v2": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
