{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // Tests walk AST fixtures by index; the strict indexed-access narrowing
    // adds mechanical guards with no defect-finding power here. src/ keeps
    // full strictness via the package tsconfig.
    "noUncheckedIndexedAccess": false
  },
  "include": [".", "../src"]
}
