{
  "name": "@glion/lint-profile-timestamps",
  "version": "0.30.0",
  "description": "Lint rule to warn when a DT, TM, or DTM value is not a valid date or time",
  "keywords": [
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "nodejs",
    "timestamp",
    "typescript"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/lint-profile-timestamps"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:readme": "glion-check-readme",
    "mutate": "stryker run",
    "publint": "publint --strict",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@glion/annotate-profile-datatypes": "workspace:*",
    "@glion/ast": "workspace:*",
    "@glion/util-timestamp": "workspace:*",
    "@glion/util-visit": "workspace:*",
    "unified-lint-rule": "3.0.1"
  },
  "devDependencies": {
    "@glion/annotate-profile-context": "workspace:*",
    "@glion/annotate-profile-fields": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.12",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
