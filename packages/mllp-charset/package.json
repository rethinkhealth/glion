{
  "name": "@glion/mllp-charset",
  "version": "0.17.0",
  "description": "MLLP middleware that rejects inbound HL7v2 messages whose MSH-18 character set is not allowed",
  "keywords": [
    "charset",
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "middleware",
    "mllp",
    "nodejs",
    "typescript",
    "utf-8"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/mllp-charset"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit",
    "check:readme": "glion-check-readme",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@glion/ack": "workspace:*",
    "@glion/mllp": "workspace:*"
  },
  "devDependencies": {
    "@glion/ast": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/hl7v2": "workspace:*",
    "@glion/mllp-ack": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0"
}
