{
  "name": "@glion/annotate-delimiters",
  "version": "0.18.0",
  "description": "Unified plugin to annotate file.data with HL7v2 delimiters derived from MSH-1/MSH-2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/annotate-delimiters"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit",
    "check:readme": "glion-check-readme",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@glion/util-query": "workspace:*"
  },
  "devDependencies": {
    "@glion/ast": "workspace:*",
    "@glion/builder": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@glion/utils": "workspace:*",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
