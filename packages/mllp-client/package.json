{
  "name": "@glion/mllp-client",
  "version": "0.18.0",
  "description": "Persistent, single-flight MLLP client for HL7v2",
  "keywords": [
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "mllp",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/mllp-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/runtime/node.js",
    "./workers": "./dist/runtime/workers.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:readme": "glion-check-readme",
    "publint": "publint --strict",
    "test": "vitest run",
    "test:cf": "vitest run --config vitest.workers.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@glion/ack": "workspace:*",
    "@glion/ast": "workspace:*",
    "@glion/mllp-codec": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/to-hl7v2": "workspace:*",
    "@glion/util-charset": "workspace:*",
    "@glion/util-query": "workspace:*"
  },
  "devDependencies": {
    "@glion/check-readme": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.11",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
