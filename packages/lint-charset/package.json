{
  "name": "@glion/lint-charset",
  "version": "0.17.0",
  "description": "hl7v2-lint rule to warn when the MSH-18 character set is not an allowed encoding (defaults to UTF-8)",
  "keywords": [
    "character-set",
    "charset",
    "definition",
    "hl7",
    "hl7v2",
    "hl7v2-lint",
    "hl7v2-lint-rule",
    "lint",
    "msh-18",
    "nodejs",
    "rule",
    "typescript",
    "utf-8"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/lint-charset"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit",
    "check:readme": "glion-check-readme",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@glion/util-query": "workspace:*",
    "unified-lint-rule": "3.0.1"
  },
  "devDependencies": {
    "@glion/ast": "workspace:*",
    "@glion/builder": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@types/node": "25.6.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "4.1.5",
    "publint": "0.3.18",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0"
}
