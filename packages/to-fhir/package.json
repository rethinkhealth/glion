{
  "name": "@glion/to-fhir",
  "version": "0.0.0",
  "private": true,
  "description": "Compile HL7v2 messages into FHIR resources",
  "keywords": [
    "fhir",
    "health",
    "healthcare",
    "hl7",
    "hl7v2",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://glion.dev",
  "license": "MIT",
  "author": {
    "name": "Melek Somai",
    "email": "melek@rethinkhealth.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkhealth/glion.git",
    "directory": "packages/to-fhir"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "check:readme": "glion-check-readme",
    "mutate": "stryker run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@glion/annotate-profile-fields": "workspace:*",
    "@glion/ast": "workspace:*",
    "@glion/util-query": "workspace:*",
    "pluralize": "8.0.0",
    "unified": "11.0.5",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@glion/annotate-delimiters": "workspace:*",
    "@glion/annotate-profile-context": "workspace:*",
    "@glion/check-readme": "workspace:*",
    "@glion/decode-escapes": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/testing": "workspace:*",
    "@glion/transform-profile-groups": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "25.6.0",
    "@types/pluralize": "^0.0.33",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
