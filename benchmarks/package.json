    "@glion/annotate-profile-fields": "workspace:*",
    "@glion/annotate-profile-fields-code-systems": "workspace:*",
    "@glion/builder": "workspace:*",
    "@glion/hl7v2": "workspace:*",
    "@glion/mllp": "workspace:*",
    "@glion/mllp-client": "workspace:*",
    "@glion/mllp-codec": "workspace:*",
    "@glion/parser": "workspace:*",
    "@glion/preset-annotate-profile-recommended": "workspace:*",
    "@glion/preset-lint-profile-recommended": "workspace:*",
    "@glion/profiles": "workspace:*",
    "@glion/to-hl7v2": "workspace:*",
    "@glion/tsconfig": "workspace:*",
    "@glion/util-query": "workspace:*",
    "@types/node": "25.6.0",
